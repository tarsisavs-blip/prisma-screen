{
  "name": "prisma-screen",
  "productName": "prisma-screen",
  "version": "1.3.0",
  "description": "Ponte entre o prisma-screen (celular) e o Holyrics: passa slides por teclas (sem API) e gera um link de transmissão com laser, destaque e tela preta.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "br.parakleto.passador.holyrics",
    "productName": "prisma-screen",
    "icon": "build/icon.png",
    "files": ["main.js", "keys.js", "holyrics-api.js", "stream.js", "stream.html", "preview.js", "debug.html", "debug.js", "preload.js", "ui.html", "ui.js", "icon.png", "lib/**/*"],
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
