{
  "manifest_version": 3,
  "name": "prisma-screen",
  "version": "1.1.0",
  "description": "Recebe comandos do celular (passar slide, laser, destaque, tela preta) e os aplica somente na aba que você autorizar.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "prisma-screen" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage", "offscreen", "tabs"],
  "optional_permissions": ["debugger"],
  "host_permissions": ["<all_urls>"]
}
